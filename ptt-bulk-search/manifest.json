{
  "manifest_version": 3,
  "name": "PTT Bulk Task Search",
  "version": "4.0",
  "description": "PTT Task Key Bulk Search with Google Login - Runs in a new tab",
  "permissions": [
    "tabs",
    "storage",
    "identity"
  ],
  "oauth2": {
    "client_id": "REPLACE_WITH_YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },
  "host_permissions": [
    "https://live.pttgps.com/*",
    "https://www.googleapis.com/*"
  ],
  "action": {
    "default_popup": "launcher.html",
    "default_title": "PTT Bulk Task Search"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}