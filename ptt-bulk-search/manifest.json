{
  "manifest_version": 3,
  "name": "PTT Bulk Task Search",
  "version": "4.4",
  "description": "PTT Task Key Bulk Search with Google Group Auth - Runs in a new tab",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://live.pttgps.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "action": {
    "default_popup": "launcher.html",
    "default_title": "PTT Bulk Task Search"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
