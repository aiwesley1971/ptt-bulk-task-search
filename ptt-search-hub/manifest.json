{
  "manifest_version": 3,
  "name": "PTT Search Hub",
  "version": "5.0",
  "description": "PTT Task Key, Model Code, and Jira Issue Key search on live.pttgps.com with Google Group Auth",
  "permissions": [
    "tabs",
    "storage",
    "identity"
  ],
  "oauth2": {
    "client_id": "390605028262-mrfkoicfcoat0e06t25bk1dhjgp89oog.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/userinfo.email"]
  },
  "host_permissions": [
    "https://live.pttgps.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "action": {
    "default_popup": "launcher.html",
    "default_title": "PTT Search Hub"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
